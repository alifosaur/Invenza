# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/invenza

# ─── JWT ─────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── OTP ─────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# ─── SMTP (for OTP emails) ────────────────────────────────────
# Leave SMTP_USER and SMTP_PASSWORD empty in development.
# In dev mode, the OTP code is returned directly in the API response.
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASSWORD=your-app-password   ← use App Password, not your real Gmail password
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@invenza.com
EMAILS_FROM_NAME=Invenza

# ─── Redis (optional) ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── App ─────────────────────────────────────────────────────
APP_ENV=development
FRONTEND_URL=http://localhost:5173
